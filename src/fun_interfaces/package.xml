<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fun_interfaces</name>
  <version>0.0.0</version>
  <description>Message and action definitions shared by all fun-machine packages</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO: License declaration</license>

  <!-- Tools needed to BUILD: cmake + the code generator for msg/action files -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Types our definitions use -->
  <depend>builtin_interfaces</depend>  <!-- for builtin_interfaces/Time -->
  <depend>action_msgs</depend>         <!-- needed by any .action file -->

  <!-- Needed at RUN time by anyone using the generated code -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Marks this as an interface package -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
